<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>gbsweep</AssemblyName>
    <RootNamespace>GbSweep</RootNamespace>
    <NoWarn>$(NoWarn);CS8509</NoWarn>
  </PropertyGroup>

  <!--
    Depends on the CoreBoy-based debug emulator from the GameboyMcp repo,
    expected as a sibling checkout: ~/Repos/GameboyMcp and ~/Repos/nes-sfx-ripper.
    Override with -p:GbMcpDir=/path/to/GameboyMcp if located elsewhere.
  -->
  <PropertyGroup>
    <GbMcpDir Condition="'$(GbMcpDir)' == ''">$(MSBuildProjectDirectory)/../../../GameboyMcp</GbMcpDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(GbMcpDir)/src/GameBoy.Debug.Emulator/GameBoy.Debug.Emulator.csproj" />
  </ItemGroup>

</Project>
